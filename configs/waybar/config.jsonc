// ~/.config/waybar/config.jsonc — rendered by sy
{
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left":   ["niri/workspaces", "niri/language"],
    "modules-center": ["niri/window"],
    // `custom/sy-mon` remains available for operators who want the
    // aggregate dashboard; per-plane read-only tiles stay on the rail.
    "modules-right":  ["cpu", "memory", "custom/sy-gpu", "custom/sy-npu", "custom/sy-disk", "custom/sy-silent", "custom/sy-vol", "custom/sy-bl"{% if features.knowledge %}, "custom/sy-knowledge"{% endif %},
{% if features.agent %}        "custom/agents",
{% endif %}        "custom/bt", "network", "custom/sy-portal", "custom/notif", "clock",
{% if features.auth %}        "custom/sy-syauth",
{% endif %}        "custom/sy-profile", "custom/sy-bat"{% if features.power %}, "custom/sy-power"{% endif %}],

    "custom/sy-power": {
        "format": "⏻",
        "tooltip": "Power menu (Mod+Shift+Escape)",
        "on-click": "{{ sy_bin }} power"
    },

    "niri/workspaces": {
        "format": "{value}",
        "format-icons": {
            "urgent":  "[!]",
            "active":  "[*]",
            "default": "[ ]"
        }
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 80,
        "tooltip": false
    },

    "niri/language": {
        "format": "{short}",
        "tooltip": false
    },

    "network": {
        "format-wifi": "NET:{essid}",
        "format-ethernet": "NET:eth",
        "format-linked": "NET:{ifname}",
        "format-disconnected": "NET:off",
        "tooltip-format-wifi": "{essid}  {signalStrength}%  {ipaddr}\nleft-click: network menu · right-click: nmtui",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}\nleft-click: network menu · right-click: nmtui",
        "tooltip-format-disconnected": "disconnected\nleft-click: network menu · right-click: nmtui",
        "on-click": "{{ sy_bin }} net",
        "on-click-right": "{{ sy_bin }} popup nmtui"
    },

    // Captive-portal / no-internet indicator. Hidden (zero width) whenever any
    // uplink has real internet; shows ⚠ when wifi or gsm is behind a captive
    // portal (login / top-up required) or connected without a route out.
    // Left-click opens a plain-HTTP page to surface the portal; right-click
    // opens the network menu. interval=10 reads NM's cached per-device
    // connectivity (no extra probe traffic).
    "custom/sy-portal": {
        "exec":           "{{ sy_bin }} net --waybar",
        "return-type":    "json",
        "interval":       10,
        "signal":         17,
        "tooltip":        true,
        "on-click":       "xdg-open http://neverssl.com",
        "on-click-right": "{{ sy_bin }} net"
    },

    "custom/agents": {
        "exec":           "{{ sy_bin }} agt waybar",
        "return-type":    "json",
        "interval":       5,
        "signal":         9,
        "on-click":       "{{ sy_bin }} agt menu",
        "on-click-right": "{{ sy_bin }} popup agents"
    },

{% if features.knowledge %}    "custom/sy-knowledge": {
        "exec":            "{{ sy_bin }} knowledge waybar",
        "return-type":     "json",
        "interval":        30,
        "signal":          11,
        "tooltip":         true,
        "on-click":        "{{ sy_bin }} knowledge pick",
        "on-click-middle": "{{ sy_bin }} knowledge toggle-pause"
    },
{% endif %}

    "custom/notif": {
        "exec": "{{ sy_bin }} notif waybar",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "on-click": "{{ sy_bin }} notif",
        "on-click-right": "{{ sy_bin }} notif clear"
    },

    "custom/bt": {
        "exec": "{{ sy_bin }} bt --waybar",
        "return-type": "json",
        "interval": 5,
        "on-click": "{{ sy_bin }} bt"
    },

    // interval=1 is intentional for pair-flow latency: the LESC
    // confirmation popup must surface within ~1s of `syauth pair`
    // writing pair-request.json. The `signal` field (waybar SIGRTMIN+N
    // wakes) already covers on-demand refreshes for the five-state
    // pill in crates/sy-auth/src/syauth.rs::render_pill; do NOT raise this without
    // also wiring a signal sender on pair start.
    "custom/sy-syauth": {
        "exec":            "{{ sy_bin }} syauth --waybar",
        "return-type":     "json",
        "interval":        1,
        "on-click":        "{{ sy_bin }} syauth accept",
        "on-click-right":  "{{ sy_bin }} syauth reject",
        "tooltip":         true
    },

    "clock": {
        "interval": 30,
        "format": "[{:%a %d %b  %H:%M}]",
        "on-click": "{{ sy_bin }} popup cal",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "format": {
                "months":   "<span color='{{ colors.yellow }}'><b>{}</b></span>",
                "days":     "<span color='{{ colors.fg }}'>{}</span>",
                "weeks":    "<span color='{{ colors.aqua }}'>W{}</span>",
                "weekdays": "<span color='{{ colors.orange }}'><b>{}</b></span>",
                "today":    "<span color='{{ colors.red }}'><b><u>{}</u></b></span>"
            }
        }
    },

    "cpu": {
        "interval": 2,
        "format": " {icon}",
        "format-icons": ["▁","▂","▃","▄","▅","▆","▇","█"],
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "CPU {usage}%"
    },

    "memory": {
        "interval": 3,
        "format": " {icon}",
        "format-icons": ["▁","▂","▃","▄","▅","▆","▇","█"],
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "RAM {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
    },

    "custom/sy-gpu": {
        "exec": "{{ sy_bin }} gpu --waybar",
        "return-type": "json",
        "interval": 5,
        "signal": 15,
        "on-click": "{{ foot_bin }} -e {{ sy_bin }} gpu"
    },

    "custom/sy-npu": {
        "exec": "{{ sy_bin }} npu --waybar",
        "return-type": "json",
        "interval": 2,
        "signal": 16,
        "on-click": "{{ foot_bin }} -e {{ sy_bin }} npu"
    },

    "custom/sy-disk": {
        "exec": "{{ sy_bin }} disk --waybar",
        "return-type": "json",
        "interval": 60,
        "signal": 13,
        "on-click": "{{ sy_bin }} disk"
    },

    "custom/sy-silent": {
        "exec": "{{ sy_bin }} silent --waybar",
        "return-type": "json",
        "interval": 60,
        "signal": 14,
        "on-click": "{{ sy_bin }} silent"
    },

    "custom/sy-vol": {
        "exec": "{{ sy_bin }} vol --waybar",
        "return-type": "json",
        "interval": 30,
        "signal": 11,
        "on-click": "{{ sy_bin }} vol pick",
        "on-click-right": "{{ sy_bin }} vol mute",
        "on-scroll-up": "{{ sy_bin }} vol up",
        "on-scroll-down": "{{ sy_bin }} vol down"
    },

    "custom/sy-bl": {
        "exec": "{{ sy_bin }} bright --waybar",
        "return-type": "json",
        "interval": 60,
        "signal": 12,
        "on-scroll-up": "{{ sy_bin }} bright up",
        "on-scroll-down": "{{ sy_bin }} bright down"
    },

    "custom/sy-bat": {
        "exec": "{{ sy_bin }} bat --waybar",
        "return-type": "json",
        "interval": 30
    },

    // Thin UI over Fedora tuned-ppd. `sy` owns no power policy and writes no
    // sysfs knobs: clicks only set the standard ActiveProfile D-Bus property.
    "custom/sy-profile": {
        "exec":            "{{ sy_bin }} profile --waybar",
        "return-type":     "json",
        "interval":        10,
        "signal":          18,
        "tooltip":         true,
        "on-click":        "{{ sy_bin }} profile next",
        "on-click-middle": "{{ sy_bin }} profile balanced",
        "on-click-right":  "{{ sy_bin }} profile"
    },

    // sy-mon ROADMAP Step 22: one-shot tile sourced from the 1 Hz
    // aggregator's `system.mon.snapshot` over UDS. interval=2 keeps the
    // tile fresh without polling faster than the aggregator's own tick;
    // on-click invokes the bare `sy mon` (Step 19 toggle path) so a
    // first click opens the popup and a second dismisses. Module body
    // also lives in configs/waybar/modules/sy-mon.json for operators
    // who pull individual modules into a custom config.
    "custom/sy-mon": {
        "exec":        "{{ sy_bin }} mon waybar",
        "return-type": "json",
        "interval":    2,
        "tooltip":     true,
        "on-click":    "{{ sy_bin }} mon"
    }
}
