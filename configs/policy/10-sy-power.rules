// sy-power roadmap Step 13 — polkit rule placeholder for the
// `org.sy.PowerProfile.SetProfile` action.
//
// The action itself lands at Step 15 (the actuator); this rule is
// staged now so that, once the actuator publishes the action over
// D-Bus, members of the `wheel` group can change profiles without
// an extra polkit dialog. Until the action exists this file is a
// no-op (polkit ignores rules whose action.id never appears).
//
// Why `wheel`: matches the rest of sy's privileged surface
// (`sy fido`, `sy syauth install-pam`) — the operator role is the
// administrator role. R7 (Step 37) extends this rule with the PPD
// shim action namespace; do not edit here without updating the
// ROADMAP entry first.
//
// Installed by `sy power apply` to `/etc/polkit-1/rules.d/`.
// Source of truth lives in this repo per CLAUDE.md "no snowflakes".
polkit.addRule(function(action, subject) {
    if (action.id == "org.sy.PowerProfile.SetProfile" &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
