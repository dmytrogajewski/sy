# sy-power cpufreq oneshot — sets amd-pstate=active + scaling_governor=powersave
# at boot so EPP writes from the user-mode sy-powerd daemon stay un-EBUSY.
#
# Without this:
#   - amd-pstate may default to `passive` mode → the EPP knob
#     (`energy_performance_preference`) is absent from
#     `/sys/devices/system/cpu/cpufreq/policy*/`, and the EPP actuator
#     silently no-ops on every tick (or, on some kernels, writes EBUSY).
#   - `scaling_governor` may default to `performance` → kernel rejects
#     EPP writes with EBUSY because EPP is meaningful only under the
#     `powersave` governor on amd-pstate=active.
#
# What it does:
#   - Writes `active` to `/sys/devices/system/cpu/amd_pstate/status` so
#     the EPP hint surface materialises.
#   - Writes `powersave` to every `cpufreq/policy*/scaling_governor` so
#     EPP writes from the user-mode daemon don't hit EBUSY.
#
# Shape:
#   - `Type=oneshot` + `RemainAfterExit=yes`: systemctl status shows
#     `active (exited)` after the writes land, not `inactive (dead)`.
#   - Runs as root (system unit) because both sysfs targets are
#     `root:root 0644` on stock Fedora.
#   - `After=multi-user.target`: late enough that all CPUs are online
#     and cpufreq policy dirs exist; if amd-pstate's `status` file is
#     read-only on this kernel build the write fails cleanly and
#     `sy-powerd` falls through to the EPP actuator's existing
#     EBUSY-handling path.
#
# Source: specs/roadmaps/sy-power-production/ROADMAP.md Step P3-2.

[Unit]
Description=sy-power cpufreq mode (amd-pstate=active + governor=powersave)
Documentation=https://github.com/dmytrogajewski/sy
After=multi-user.target
Wants=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo active > /sys/devices/system/cpu/amd_pstate/status'
ExecStart=/bin/sh -c 'for p in /sys/devices/system/cpu/cpufreq/policy*; do echo powersave > "$p/scaling_governor"; done'

[Install]
WantedBy=multi-user.target
