# Local qdrant instance behind `sy-knowledge.service`. Qdrant is a
# third-party binary that doesn't implement sd_notify, so it stays
# `Type=simple` indefinitely (SPEC §4.5 explicitly carves this out —
# notify support is for sy's own daemons only).
#
# Storage path and port are pinned via `QDRANT__STORAGE__STORAGE_PATH`
# and `QDRANT__SERVICE__HTTP_PORT` (the env-var form qdrant looks at).
# This MUST match what `sy::knowledge::daemon::spawn_qdrant` would
# pass — otherwise we end up with two qdrant processes pointing at
# different storage dirs and a phantom "all 60k embeddings missing"
# (the daemon's HTTP client hits whichever port-bound qdrant is up,
# but its index.json tracks what it thought it had written).
#
# `data_dir()` in `src/knowledge/state.rs` resolves to
# `$XDG_DATA_HOME/sy` (default `%h/.local/share/sy`), and
# `qdrant_storage_dir()` appends `/knowledge/qdrant`.
#
# Source: specs/research/architecture-refactor/SPEC.md §4.5.

[Unit]
Description=sy local qdrant
PartOf=sy.target

[Service]
Type=simple
Environment=QDRANT__SERVICE__HTTP_PORT=6333
Environment=QDRANT__SERVICE__HOST=127.0.0.1
Environment=QDRANT__STORAGE__STORAGE_PATH=%h/.local/share/sy/knowledge/qdrant
Environment=QDRANT__STORAGE__SNAPSHOTS_PATH=%h/.local/share/sy/knowledge/qdrant/snapshots
Environment=QDRANT__TELEMETRY_DISABLED=true
# BUG-20260524-2203: scrub the storage tree before qdrant boots.
# Without this, one segment with an empty / unparseable JSON file
# (left over from a SIGKILL / OOM mid-atomicwrite) panics qdrant
# inside `Collection::load`, systemd burns through StartLimitBurst
# in under a second, and the knowledge plane plus the NPU embedder
# it hosts both stay dark until a human runs `find -size 0` by
# hand. `sy knowledge repair-qdrant` is idempotent and exits 0 on a
# clean tree, so this is safe to run unconditionally.
ExecStartPre=%h/.local/bin/sy knowledge repair-qdrant --quiet
ExecStart=%h/.local/bin/qdrant
Restart=on-failure

[Install]
WantedBy=sy.target