# sy stack bar — iced+layer-shell tile rail under waybar (see
# `src/stack/bar/app.rs`). Follows the niri graphical session, so
# its `WantedBy=` is `graphical-session.target` rather than
# `sy.target` — that way the bar surface is attached during the
# session even if `sy.target` itself is masked.
#
# `PartOf=sy.target` is still declared so `systemctl --user stop
# sy.target` brings the bar down with the rest of the AI plane.
# This double-binding (`PartOf` one target, `WantedBy` another) is
# a standard systemd idiom — `PartOf` only propagates stop /
# restart cascades, not start triggers.
#
# `Type=notify`: `src/stack/bar/app.rs` calls
# `sy_core::notify::ready()` on the first `Msg::WindowOpened` —
# the moment the iced layer-shell surface attaches, which is the
# bar's "ready to serve" analogue of a daemon IPC bind.
# `sy_core::notify::spawn_watchdog` pings `WATCHDOG=1` at
# half-interval. `STOPPING=1` is intentionally not emitted: iced
# owns the event loop after `run()` and exits the process directly,
# so there is no idiomatic shutdown hook to attach it to — the
# `Restart=on-failure` policy compensates.
#
# Source: specs/research/architecture-refactor/SPEC.md §4.5.

[Unit]
Description=sy stack bar (iced layer-shell tile rail)
After=graphical-session.target sy-waybar.service
Wants=sy-waybar.service
PartOf=sy.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=300s
TimeoutStartSec=300s
# Wait for Waybar's layer surface, not merely its process. Mapping it
# first gives Waybar the full top edge before our right reservation.
ExecStartPre=/usr/bin/bash -c 'until niri msg --json layers | jq -e ".[] | select(.namespace == \\"top\\")" >/dev/null 2>&1; do sleep 0.05; done'
ExecStart=%h/.local/bin/sy stack bar
Restart=on-failure
RestartSec=2s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sy-stack-bar

[Install]
WantedBy=graphical-session.target
