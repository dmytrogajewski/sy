[Unit]
Description=sy standalone AI inference plane
PartOf=sy.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=300s
TimeoutStartSec=300s
ExecStart=%h/.local/bin/sy aiplane daemon
LimitMEMLOCK=infinity
MemoryHigh=16G
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sy-aiplane

[Install]
WantedBy=sy.target
