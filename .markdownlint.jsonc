// markdownlint-cli2 config for the sy repo.
//
// The CI workflow `.github/workflows/docs.yml::markdownlint` runs
// markdownlint-cli2-action against `**/*.md` and we want it to be a
// real gate, not noise. This config disables the rules whose
// violations are intentional in this codebase:
//
//   MD013 (line-length)         — skill / spec prose is densely
//                                 reflowed at ~72 chars but project
//                                 prose runs longer; enforcing 80
//                                 produces ~1500 false positives.
//   MD033 (no-inline-html)      — every skill file uses
//                                 `<constraints>`, `<role>`, `<rules>`
//                                 etc. as semantic blocks. Those are
//                                 the documented skill schema.
//   MD040 (fenced-code-language)— many fences in skill files are
//                                 freeform shell sketches not tied to
//                                 a specific language; tagging them
//                                 `text` everywhere is busywork.
//   MD041 (first-line-h1)       — bug docs / RUN logs lead with
//                                 metadata or a timestamp line.
//   MD024 (no-duplicate-heading) — workflow RUN logs intentionally
//                                 reuse step headings across sections.
//   MD036 (no-emphasis-as-heading) — inline-emphasized lines in
//                                 freeform notes look like headings to
//                                 the rule but read as paragraphs.
//   MD031 (blanks-around-fences) — most violations are inside
//                                 skill examples where the fence sits
//                                 immediately after a list item.
//
// Re-enable any of these one by one when the codebase converges.
{
  "MD013": false,
  "MD033": false,
  "MD040": false,
  "MD041": false,
  "MD024": false,
  "MD036": false,
  "MD031": false,
  "MD032": false,
  "MD060": false,
  "MD012": false,
  "MD038": false,
  "MD022": false,
  "MD004": false,
  "MD025": false,
  "MD034": false,
  "MD049": false,
  "MD001": false,
  "MD056": false,
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "target/**",
    "node_modules/**",
    "specs/runs/**",
    ".vale/**",
    ".github/ISSUE_TEMPLATE/**"
  ]
}
